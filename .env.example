DB_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=jdbc:postgresql://localhost:5432/fileconvert
DB_USERNAME=postgres
# Generate with: openssl rand -base64 64
JWT_SECRET=
GOOGLE_CLIENT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FRONTEND_URL=http://localhost:8088
BACKEND_URL=http://localhost:8088
CORS_ALLOWED_ORIGINS=http://localhost:8088
CONVERSION_GUEST_DAILY_LIMIT=2
CONVERSION_USER_DAILY_LIMIT=10
FILE_EXPIRY_MINUTES=30

# Reduce concurrency to 1 on smaller hosts; native tools need RAM outside the JVM heap.
CONVERSION_MAX_CONCURRENT=2
CONVERSION_TIMEOUT_SECONDS=120
CONVERSION_MAX_OUTPUT_MB=200
# Local Linux ImageMagick 6 uses convert; Docker already sets this.
# IMAGEMAGICK_BINARY=convert

# Conversion fidelity and native worker resources.
CONVERSION_MAX_PDF_STYLES=1024
BACKEND_MEMORY_LIMIT=2g
BACKEND_CPU_LIMIT=2
# Optional override; standard Ubuntu/macOS sRGB profiles are detected automatically.
# IMAGE_SRGB_PROFILE=/usr/share/color/icc/sRGB.icc

# Conversion verification, bounded cleanup, and durable background jobs.
CONVERSION_PDF_VERIFICATION=structural
FILE_CLEANUP_BATCH_SIZE=100
FILE_CLEANUP_MAX_BATCHES=10
CONVERSION_JOBS_ENABLED=true
CONVERSION_JOBS_MAX_PENDING=20
CONVERSION_JOBS_RETENTION_MINUTES=60
CONVERSION_JOBS_QUEUE_TIMEOUT_SECONDS=900
CONVERSION_JOBS_UPLOAD_TIMEOUT_SECONDS=300
CONVERSION_JOBS_POLL_INTERVAL_MS=1000
CONVERSION_JOBS_MAINTENANCE_INTERVAL_MS=10000
